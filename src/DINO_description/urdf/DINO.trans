<?xml version="1.0" ?>
<robot name="DINO" xmlns:xacro="http://www.ros.org/wiki/xacro" >

<transmission name="upperleftservo_joint_tran">
  <type>transmission_interface/SimpleTransmission</type>
  <joint name="upperleftservo_joint">
    <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
  </joint>
  <actuator name="upperleftservo_joint_actr">
    <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
    <mechanicalReduction>1</mechanicalReduction>
  </actuator>
</transmission>

